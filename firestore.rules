rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users Collection: Anyone authenticated can read user profiles, but only the owner can write their own profile
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Chats Collection: Only participants in the conversation can read and write messages/metadata
    match /chats/{chatId} {
      allow read, write: if request.auth != null && (
        resource == null || request.auth.uid in resource.data.participants
      );

      // Subcollection: Messages
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }

    // Top-level Messages Collection (used for cross-path message synchronization)
    match /messages/{messageId} {
      allow read, write: if request.auth != null;
    }

    // Groups Collection: Only authorized group members can access and chat
    match /groups/{groupId} {
      allow read, write: if request.auth != null;

      match /messages/{msgId} {
        allow read, write: if request.auth != null;
      }
    }

    // Status / Stories Collection: Authenticated users can read/write 24h statuses
    match /statuses/{statusId} {
      allow read, write: if request.auth != null;
    }

    // Calls Collection: WebRTC signaling accessible to callers and callees
    match /calls/{callId} {
      allow read, write: if request.auth != null;

      match /callerCandidates/{candId} {
        allow read, write: if request.auth != null;
      }

      match /calleeCandidates/{candId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
