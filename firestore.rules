rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if user is signed in
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    // 1. USERS COLLECTION
    // Any signed-in user can read profiles for search/chat headers.
    // A user can ONLY create or update their own profile document (no sharedMessages allowed).
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.auth.uid == userId
        && (!("uid" in request.resource.data) || request.resource.data.uid == request.auth.uid);
      allow delete: if false;
    }

    // 2. DIRECT CHATS COLLECTION (chats/{chatId})
    match /chats/{chatId} {
      // Allow reading a single chat doc even if it does not exist yet (resource == null)
      allow get: if isSignedIn() && (
        resource == null ||
        request.auth.uid in resource.data.participants
      );

      // Allow querying the user's own chat list
      allow list: if isSignedIn() && (
        request.auth.uid in resource.data.participants
      );

      // Allow creating a chat only if the logged-in user is in participants
      allow create: if isSignedIn()
        && "participants" in request.resource.data
        && request.auth.uid in request.resource.data.participants;

      // Allow updating chat metadata (lastMessage, unread counts) only if participant
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participants
        && request.auth.uid in request.resource.data.participants;

      allow delete: if false;

      // 3. DIRECT CHAT MESSAGES SUBCOLLECTION (chats/{chatId}/messages/{messageId})
      match /messages/{messageId} {
        // Only participants of this chat may read messages
        allow read: if isSignedIn() && (
          ("participants" in resource.data && request.auth.uid in resource.data.participants) ||
          resource.data.senderId == request.auth.uid ||
          resource.data.receiverId == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
        );

        // Sender UID MUST equal the currently authenticated Firebase UID
        allow create: if isSignedIn()
          && request.resource.data.senderId == request.auth.uid
          && "participants" in request.resource.data
          && request.auth.uid in request.resource.data.participants;

        // Allow participants to mark messages as read or delete for me/everyone
        allow update: if isSignedIn() && (
          resource.data.senderId == request.auth.uid ||
          resource.data.receiverId == request.auth.uid ||
          ("participants" in resource.data && request.auth.uid in resource.data.participants)
        ) && request.resource.data.senderId == resource.data.senderId;

        allow delete: if false;
      }
    }

    // 4. GROUPS COLLECTION (groups/{groupId})
    match /groups/{groupId} {
      allow read: if isSignedIn() && (
        resource == null ||
        request.auth.uid in resource.data.members
      );

      allow create: if isSignedIn()
        && request.resource.data.primaryAdmin == request.auth.uid
        && request.auth.uid in request.resource.data.admins
        && request.auth.uid in request.resource.data.members;

      // Members can update lastMessage when sending; only admins can change members/admins/name
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.members
        && (
          request.auth.uid in resource.data.admins ||
          (
            request.resource.data.members == resource.data.members &&
            request.resource.data.admins == resource.data.admins &&
            request.resource.data.primaryAdmin == resource.data.primaryAdmin
          )
        );

      allow delete: if false;

      // GROUP MESSAGES SUBCOLLECTION (groups/{groupId}/messages/{messageId})
      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          ("participants" in resource.data && request.auth.uid in resource.data.participants) ||
          request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members
        );

        allow create: if isSignedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;

        allow update: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members
          && request.resource.data.senderId == resource.data.senderId;

        allow delete: if false;
      }
    }

    // 5. STATUSES / STORIES COLLECTION (statuses/{statusId})
    match /statuses/{statusId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.uid == request.auth.uid ||
        request.resource.data.uid == resource.data.uid
      );
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // 6. WEBRTC CALLS SIGNALING COLLECTION (calls/{callId})
    match /calls/{callId} {
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.callerId == request.auth.uid ||
        resource.data.calleeId == request.auth.uid
      );

      allow create: if isSignedIn()
        && request.resource.data.callerId == request.auth.uid;

      allow update: if isSignedIn() && (
        resource.data.callerId == request.auth.uid ||
        resource.data.calleeId == request.auth.uid
      );

      match /callerCandidates/{candidateId} {
        allow read, write: if isSignedIn();
      }

      match /calleeCandidates/{candidateId} {
        allow read, write: if isSignedIn();
      }
    }
  }
}
